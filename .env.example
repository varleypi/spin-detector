# ── Anthropic (required for pipeline) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── NewsAPI (required for pipeline) ──────────────────────────────────────────
# Free tier: 100 req/day — https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# ── Supabase (required for live mode) ────────────────────────────────────────
# Create a project at supabase.com, then run supabase/schema.sql in the SQL editor.
SUPABASE_URL=https://your-project.supabase.co

# Anon key — safe to expose in frontend (used by Next.js API routes for public reads)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — NEVER expose publicly (used only by the pipeline for writes)
SUPABASE_SERVICE_KEY=eyJ...

# ── App URL (required for server-side API calls in production) ────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── X (Twitter) viral headline scoring ────────────────────────────────────────
# See docs/x-viral-scoring-design.md. Pipeline: node pipeline/x/run.js

# xAI — used for discovery (x_search on grok-4.5) and scoring (grok-3-mini).
XAI_API_KEY=xai-...

# X API credentials — OAuth 1.0a user tokens, app needs Read+Write.
# Free tier is write-only, which is enough: we post but discover via Grok.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Protects /admin/x-queue and the posting route. Use a long random string.
X_QUEUE_ADMIN_SECRET=

# Caps and quality gates
DAILY_CANDIDATE_CAP=12          # max candidates scored per run
DAILY_POST_CAP=4                # max posts published per day (anti-ban)
MAX_LIVE_SEARCH_RESULTS=20      # cap on posts requested from x_search
DISCOVERY_SOURCE=grok           # 'grok' (default) | 'xapi' (needs X Basic+)
ELIGIBLE_AUTHOR_TYPES=outlet,journalist,politician,official
MIN_SPIN_THRESHOLD=1.0          # min |score-5| to be worth queueing
STORY_DEDUPE_THRESHOLD=0.18     # Jaccard similarity = same story
CANDIDATE_EXPIRY_HOURS=12       # auto-skip queue items older than this
