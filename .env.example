# ── Anthropic (required for pipeline) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── NewsAPI (required for pipeline) ──────────────────────────────────────────
# Free tier: 100 req/day — https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# ── Supabase (required for live mode) ────────────────────────────────────────
# Create a project at supabase.com, then run supabase/schema.sql in the SQL editor.
SUPABASE_URL=https://your-project.supabase.co

# Anon key — safe to expose in frontend (used by Next.js API routes for public reads)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — NEVER expose publicly (used only by the pipeline for writes)
SUPABASE_SERVICE_KEY=eyJ...

# ── App URL (required for server-side API calls in production) ────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── X (Twitter) auto-reply ────────────────────────────────────────────────────
# See docs/x-viral-scoring-design.md. Pipeline: node pipeline/x/run.js
# Finds viral posts from tracked outlets and REPLIES with a spin score.

# xAI — used for discovery (x_search on grok-4.5) and scoring (grok-3-mini).
XAI_API_KEY=xai-...

# X API credentials — OAuth 1.0a user tokens, app needs Read+Write.
# Free tier is write-only, which is enough: we post but discover via Grok.
# NOTE: replies count against the free tier's ~500 posts/month.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Protects /admin/x-queue and the manual posting route. Long random string.
X_QUEUE_ADMIN_SECRET=

# ── THE KILL SWITCH ───────────────────────────────────────────────────────────
# Anything other than 'on' means dry run: replies are composed and recorded but
# never published. In CI this is a GitHub repository *variable* so it can be
# flipped without a deploy.
X_AUTOPOST=off

# ── Safety caps (guardrails.js) ───────────────────────────────────────────────
DAILY_POST_CAP=8                # max replies published per day
MAX_REPLIES_PER_PARENT_DAY=1    # never stack replies on one outlet
MIN_PARENT_FOLLOWERS=50000      # don't spend a slot on a small account
MAX_PARENT_AGE_MINUTES=180      # a reply under an old post is invisible
MIN_SPIN_THRESHOLD=1.0          # min |score-5| for a single-post reply
# Topic blocklist groups in force. Drop 'legal' to allow indictment coverage.
X_TOPIC_GROUPS=harm,grief,victims,health,legal

# ── Cost control ──────────────────────────────────────────────────────────────
# Discovery (agentic grok-4.5 x_search) is ~95% of spend. Measured ~$0.03–0.06
# per run. The daily budget is checked BEFORE discovery, so a capped day is free.
DAILY_COST_BUDGET_USD=1.00      # hard stop on xAI spend per day
MAX_SEARCH_CALLS=3              # search budget stated in the discovery prompt
MAX_LIVE_SEARCH_RESULTS=8       # posts requested from x_search
XAI_SEARCH_EFFORT=low           # 'low' | 'medium' | 'high' — DEFAULT IS HIGH
XAI_SEARCH_MAX_TOKENS=4000      # max_output_tokens on the discovery call
SCORE_BUDGET_PER_RUN=3          # max posts we PAY to score per run
X_HANDLES_PER_RUN=20            # handles per search (fewer = MORE expensive)
# X_DISCOVERY_HANDLES=CNN,FoxNews,...   # override the outlet pool entirely

# ── Matching and dedup ────────────────────────────────────────────────────────
CLUSTER_MATCH_THRESHOLD=0.26    # Jaccard: tweet ↔ already-scored story cluster
STORY_DEDUPE_THRESHOLD=0.18     # Jaccard: same story, different wording
DAILY_CANDIDATE_CAP=6           # max candidates carried past ranking per run
CANDIDATE_EXPIRY_HOURS=6        # auto-skip candidates older than this
DISCOVERY_SOURCE=grok           # 'grok' (default) | 'xapi' (needs X Basic+)
